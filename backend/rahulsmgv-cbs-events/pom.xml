<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Parent                                                    -->
    <!-- ========================================================= -->

    <parent>
        <groupId>com.rahulsmgv.cbs</groupId>
        <artifactId>rahulsmgv-cbs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath />
    </parent>

    <!-- ========================================================= -->
    <!-- Project Coordinates                                       -->
    <!-- ========================================================= -->

    <artifactId>rahulsmgv-cbs-events</artifactId>

    <packaging>jar</packaging>

    <name>RahulSMGV CBS Event Library</name>

    <description>
        Shared Event Contract and Event Model Library for
        RahulSMGV Core Banking System.
    </description>

    <!-- ========================================================= -->
    <!-- Dependencies                                              -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- Common Library                                        -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.rahulsmgv.cbs</groupId>
            <artifactId>rahulsmgv-cbs-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- ===================================================== -->
        <!-- Jackson Annotations                                   -->
        <!-- Used for JSON event contract annotations             -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- Jackson Databind                                      -->
        <!-- Used for event serialization/deserialization          -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- SLF4J                                                  -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- Lombok                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================================================== -->
        <!-- Testing                                                -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>