<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ========================================================= -->
    <!-- Parent                                                    -->
    <!-- ========================================================= -->

    <parent>
        <groupId>com.rahulsmgv.cbs</groupId>
        <artifactId>rahulsmgv-cbs-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath />
    </parent>

    <!-- ========================================================= -->
    <!-- Project Coordinates                                       -->
    <!-- ========================================================= -->

    <artifactId>rahulsmgv-cbs-infra</artifactId>
    <packaging>jar</packaging>

    <name>RahulSMGV CBS Infrastructure Library</name>

    <description>
        Shared Infrastructure Library for RahulSMGV Core Banking System.
        Provides reusable infrastructure components such as logging,
        exception handling, security utilities, validation, health checks,
        metrics, tracing, caching, messaging and database abstractions.
    </description>

    <!-- ========================================================= -->
    <!-- Dependencies                                              -->
    <!-- ========================================================= -->

    <dependencies>

        <!-- ===================================================== -->
        <!-- RahulSMGV Shared Libraries                            -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>com.rahulsmgv.cbs</groupId>
            <artifactId>rahulsmgv-cbs-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.rahulsmgv.cbs</groupId>
            <artifactId>rahulsmgv-cbs-security</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>com.rahulsmgv.cbs</groupId>
            <artifactId>rahulsmgv-cbs-events</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- ===================================================== -->
        <!-- Spring Framework                                      -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- Logging                                                -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- ===================================================== -->
        <!-- Lombok                                                 -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ===================================================== -->
        <!-- Testing                                                -->
        <!-- ===================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>